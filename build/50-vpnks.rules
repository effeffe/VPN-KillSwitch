// vpnks: let filippo use vpnks without password prompts.
// Installed as /etc/polkit-1/rules.d/50-vpnks.rules (generated by CMake from 50-vpnks.rules.in).
polkit.addRule(function(action, subject) {
    if (subject.user !== "filippo") return polkit.Result.NOT_HANDLED;

    // VPN namespace helper. Its "exec" only ever runs commands as the calling user.
    if (action.id === "org.vpnks.helper") return polkit.Result.YES;

    // killswitch, firewalld backend (D-Bus API)
    if (action.id.indexOf("org.fedoraproject.FirewallD1") === 0) return polkit.Result.YES;

    // killswitch, iptables / nftables / ufw backends via pkexec. This is passwordless root
    // for these four programs - delete this block if you only use firewalld.
    if (action.id === "org.freedesktop.policykit.exec") {
        var p = action.lookup("program");
        if (p === "/usr/bin/iptables" || p === "/usr/bin/ip6tables" || p === "/usr/bin/nft" || p === "/usr/bin/ufw")
            return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
